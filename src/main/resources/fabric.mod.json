{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "server",
  "entrypoints": {
    "main": ["com.marcp.directauth.DirectAuth"]
  },
  "mixins": ["directauth.mixins.json"],
  "accessWidener": "directauth.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_api_min_version}",
    "java": ">=21"
  }
}
